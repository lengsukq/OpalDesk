<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpalCast" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/opalcast_bg_dark</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.OpalCast.Fullscreen" parent="Theme.OpalCast">
        <item name="android:windowBackground">#FF040A0E</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>

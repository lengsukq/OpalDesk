{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpalDesk",
  "version": "1.0.20",
  "identifier": "io.github.lengsukq.opaldesk.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/sync-frontend.mjs",
    "beforeBuildCommand": "node ./scripts/sync-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpalDesk",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --enable-features=PlatformHEVCDecoderSupport"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
